x_n = [3, 11, 7, 0, -1, 4, 2];
nx = -3:3;

h_n = [2, 3, 0, -5, 2, 1];
nh = -1:4;

n_conv = nx(1) + nh(1) : nx(end) + nh(end);
% direct method
y_direct = conv(x_n, h_n);
subplot(1, 2, 1);
stem(n_conv, y_direct);

% using for loop
l = length(nx) + length(nh) -1;
x_padded = [ zeros(1, length(nh) -1), x_n, zeros(1, length(nh) -1)];
y_loop = zeros(1, l);
h_fllip = fliplr(h_n);

for k = 1:l
  window = x_padded(k : k + length(nh) -1);
  y_loop(k) = sum(window .* h_fllip);
end
subplot(1, 2, 2);
stem(n_conv, y_loop);
