# x(n) - 2*delta(n+1) - delta(n-4)

n = -5:5;
x_n = 2*(n==-1) - (n==4);
subplot(2, 2, 1)
stem(n, x_n);
xlabel("n");
ylabel("x_n");

# x(n) = n*[u(n) - u(n-10)] + 10*exp(-0.3(n-10)) * [u(n-10)-u(n-20)], 0 <= n <= 20

n1 = 0:20;
x_n1 = n1 .* [(n1>=0) - (n1>=10)] + 10 * (exp((-0.3) * (n1-10))) .* [(n1>=10) - (n1>=20)];
subplot(2,  2, 2);
stem(n1, x_n1);

# x(n) = cos(0.04 * pi * n) + 0.2w(n), 0<= n<= 50
n2 = 0:50;
x_n2 = cos(0.04 * pi * n2) + 0.2 * exp(-0.5 * (n2.^2)/2);
subplot(2, 2, 3);
stem(n2, x_n2);

